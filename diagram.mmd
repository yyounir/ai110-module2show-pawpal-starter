classDiagram
    class Owner {
        +String name
        +setOwnerInformation(name: String): void
        +addPet(pet: Pet): void
        +getAllTasks(): list~Task~
    }

    class Pet {
        +String name
        +String species
        +String breed
        +setPatientInformation(name: String, species: String, breed: String): void
        +addTask(task: Task): void
        +editTask(taskId: UUID, updatedTask: Task): void
    }

    class Task {
        +UUID taskId
        +String description
        +int time
        +String frequency
        +bool completed
        +String priority
        +Date dueDate
        +Time startTime
    }

    class CareTask {
        <<compatibility>>
    }

    class ScheduleConstraints {
        +int availableMinutes
        +tuple preferences
    }

    class DailyCareSchedule {
        +Date date
        +ScheduleConstraints constraints
        +list~Task~ tasks
        +generateFor(pet: Pet, date: Date, constraints: ScheduleConstraints): DailyCareSchedule
        +viewDailyCareSchedule(): String
    }

    class Scheduler {
        +Owner owner
        +getAllTasks(): list~Task~
        +markTaskComplete(taskId: UUID): Task
        +detectScheduleConflicts(schedule: DailyCareSchedule): list~String~
        +sortTasksByTime(tasks: list~Task~): list~Task~
        +filterTasks(completed: bool, petName: String): list~Task~
        +generateSchedule(date: Date, constraints: ScheduleConstraints): DailyCareSchedule
    }

    Owner "1" --> "0..*" Pet : has
    Owner --> Scheduler : provides tasks to
    Pet "1" --> "0..*" Task : has
    Pet "1" --> "0..*" DailyCareSchedule : has
    DailyCareSchedule "1" --> "0..*" Task : includes
    DailyCareSchedule --> ScheduleConstraints : uses
    CareTask --|> Task : legacy constructor
